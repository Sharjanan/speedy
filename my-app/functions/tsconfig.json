{
  "compilerOptions": {
    "types": ["node"],
    "target": "es2017",
    "module": "commonjs",
    "lib": ["es2017"],
    "noEmit": false,
    "moduleResolution": "node",
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "strict": true,
    "resolveJsonModule": true,
    "isolatedModules": false,
    "outDir": "lib",
    "rootDir": "src",
    "jsx": "react-jsx"  // ✅ Add this line to enable JSX
  },
  "include": ["src"],
  "exclude": ["node_modules"]
}
